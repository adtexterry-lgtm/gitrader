{
  "name": "gitrader-monorepo",
  "version": "0.1.1",
  "private": true,
  "description": "Gitrader is an open-source AI quant trading base: embed it in any agent, and combine it with any functional trading plugin.",
  "license": "CPAL-1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "notices": "node scripts/build.mjs --notices",
    "pack:release": "node scripts/release/build-release-assets.mjs",
    "pack:portable": "node tools/portable/build-portable.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
