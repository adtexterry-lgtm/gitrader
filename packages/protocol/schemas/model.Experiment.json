{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gitrader:schema:model:0.1:Experiment",
  "$comment": "SPDX-License-Identifier: Apache-2.0 | Spec: model | Version: 0.1 | Status: draft",
  "title": "Experiment",
  "type": "object",
  "properties": {
    "experimentId": {
      "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/ExpId"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "hypothesis": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "enum": [
        "draft",
        "backtest",
        "paper",
        "live_small",
        "review",
        "closed",
        "hypothesis",
        "holdout",
        "shadow",
        "live",
        "retired"
      ]
    },
    "subject": {
      "type": "object",
      "properties": {
        "strategy": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "minLength": 1
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/Sha256"
            }
          },
          "required": [
            "kind",
            "id",
            "version",
            "sha256"
          ]
        },
        "workflow": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "minLength": 1
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/Sha256"
            }
          },
          "required": [
            "kind",
            "id",
            "version",
            "sha256"
          ]
        },
        "params": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "number",
              "boolean",
              "string"
            ]
          }
        }
      },
      "required": [
        "params"
      ]
    },
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "range": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/Sha256"
          }
        },
        "required": [
          "source",
          "range",
          "sha256"
        ]
      }
    },
    "assumptions": {
      "$ref": "urn:gitrader:schema:model:0.1:BacktestAssumptions"
    },
    "biasChecks": {
      "type": "object",
      "properties": {
        "lookahead": {
          "enum": [
            "pass",
            "fail",
            "not_run"
          ]
        },
        "recursive": {
          "enum": [
            "pass",
            "fail",
            "not_run"
          ]
        },
        "trialCount": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "lookahead",
        "recursive",
        "trialCount"
      ]
    },
    "runs": {
      "type": "array",
      "items": {
        "$ref": "urn:gitrader:schema:model:0.1:ExperimentRun"
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "backtest": {
          "$ref": "urn:gitrader:schema:model:0.1:ExperimentMetrics"
        },
        "paper": {
          "$ref": "urn:gitrader:schema:model:0.1:ExperimentMetrics"
        },
        "live": {
          "$ref": "urn:gitrader:schema:model:0.1:ExperimentMetrics"
        }
      }
    },
    "conclusion": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "origin": {
          "$ref": "urn:gitrader:schema:model:0.1:Origin"
        },
        "at": {
          "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/Ms"
        }
      },
      "required": [
        "text",
        "origin",
        "at"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 0
    },
    "owner": {
      "$ref": "urn:gitrader:schema:model:0.1:ExperimentOwner"
    },
    "subjectKey": {
      "oneOf": [
        {
          "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/Sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "executorKind": {
      "enum": [
        "engine",
        "agent",
        null
      ]
    },
    "frozen": {
      "type": "object",
      "properties": {
        "hypothesis": {
          "type": "boolean"
        },
        "subject": {
          "type": "boolean"
        },
        "holdout": {
          "type": "boolean"
        }
      },
      "required": [
        "hypothesis",
        "subject",
        "holdout"
      ]
    },
    "holdoutWindow": {
      "oneOf": [
        {
          "$ref": "urn:gitrader:schema:model:0.1:Window"
        },
        {
          "type": "null"
        }
      ]
    },
    "holdoutRunId": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "packs": {
      "type": "array",
      "items": {
        "$ref": "urn:gitrader:schema:model:0.1:EvidencePackRef"
      }
    },
    "forward": {
      "oneOf": [
        {
          "$ref": "urn:gitrader:schema:model:0.1:ForwardStats"
        },
        {
          "type": "null"
        }
      ]
    },
    "baseline": {
      "oneOf": [
        {
          "$ref": "urn:gitrader:schema:model:0.1:BaselineRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "llm": {
      "$ref": "urn:gitrader:schema:model:0.1:ExperimentLlm"
    },
    "stageEnteredAt": {
      "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/Ms"
    },
    "reviewFrom": {
      "oneOf": [
        {
          "enum": [
            "draft",
            "backtest",
            "paper",
            "live_small",
            "review",
            "closed",
            "hypothesis",
            "holdout",
            "shadow",
            "live",
            "retired"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "conclusions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "origin": {
            "$ref": "urn:gitrader:schema:model:0.1:Origin"
          },
          "at": {
            "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/Ms"
          },
          "version": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "text",
          "origin",
          "at",
          "version"
        ]
      }
    },
    "lineage": {
      "type": "object",
      "properties": {
        "parentExperimentId": {
          "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/ExpId"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "origin": {
            "$ref": "urn:gitrader:schema:model:0.1:Origin"
          },
          "at": {
            "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/Ms"
          }
        },
        "required": [
          "text",
          "origin",
          "at"
        ]
      }
    },
    "origin": {
      "$ref": "urn:gitrader:schema:model:0.1:Origin"
    },
    "createdAt": {
      "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/Ms"
    },
    "updatedAt": {
      "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/Ms"
    }
  },
  "required": [
    "experimentId",
    "title",
    "hypothesis",
    "stage",
    "subject",
    "origin",
    "createdAt",
    "updatedAt"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "stage": {
            "const": "backtest"
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "required": [
          "assumptions"
        ]
      }
    }
  ]
}
