{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gitrader:schema:model:0.1:BacktestAssumptions",
  "$comment": "SPDX-License-Identifier: Apache-2.0 | Spec: model | Version: 0.1 | Status: draft",
  "title": "BacktestAssumptions",
  "type": "object",
  "properties": {
    "fees": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "maker": {
              "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/Decimal"
            },
            "taker": {
              "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/Decimal"
            }
          },
          "required": [
            "maker",
            "taker"
          ]
        },
        {
          "const": "venue"
        }
      ]
    },
    "slippageBps": {
      "type": "number",
      "minimum": 0
    },
    "fillModel": {
      "type": "string",
      "minLength": 1
    },
    "funding": {
      "type": "boolean"
    },
    "liquidation": {
      "type": "boolean"
    },
    "latencyMs": {
      "type": "number",
      "minimum": 0
    },
    "maxVolumeShare": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "liquidationPenaltyRatio": {
      "type": "number",
      "minimum": 0
    }
  },
  "required": [
    "fees",
    "slippageBps",
    "fillModel",
    "funding",
    "liquidation"
  ]
}
