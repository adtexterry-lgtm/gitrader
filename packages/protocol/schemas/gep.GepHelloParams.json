{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gitrader:schema:gep:0.1:GepHelloParams",
  "$comment": "SPDX-License-Identifier: Apache-2.0 | Spec: gep | Version: 0.1 | Status: draft",
  "title": "GepHelloParams",
  "type": "object",
  "properties": {
    "protocol": {
      "const": "gep"
    },
    "versions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "host": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "version"
      ]
    },
    "auth": {
      "type": "object",
      "properties": {
        "token": {
          "type": "string",
          "minLength": 1
        },
        "mtls": {
          "const": true
        }
      },
      "anyOf": [
        {
          "required": [
            "token"
          ]
        },
        {
          "required": [
            "mtls"
          ]
        }
      ]
    },
    "resume": {
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "lastSeq": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "sessionId",
        "lastSeq"
      ]
    }
  },
  "required": [
    "protocol",
    "versions",
    "host",
    "auth"
  ]
}
