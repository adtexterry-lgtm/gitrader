{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gitrader:schema:ui:0.1:KeyInfo",
  "$comment": "SPDX-License-Identifier: Apache-2.0 | Spec: ui | Version: 0.1 | Status: draft",
  "title": "KeyInfo",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "type": "string"
    },
    "address": {
      "type": "string",
      "minLength": 1
    },
    "venue": {
      "type": "string",
      "minLength": 1
    },
    "network": {
      "enum": [
        "mainnet",
        "testnet"
      ]
    },
    "createdAt": {
      "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/Ms"
    },
    "expiresAt": {
      "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/Ms"
    }
  },
  "required": [
    "id",
    "label",
    "address",
    "venue",
    "network",
    "createdAt"
  ]
}
