{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gitrader:schema:gep:0.1:Methods",
  "$comment": "SPDX-License-Identifier: Apache-2.0 | Spec: gep | Version: 0.1 | Status: draft",
  "title": "Methods",
  "$defs": {
    "Empty": {
      "type": "object",
      "additionalProperties": false
    },
    "Ok": {
      "type": "object",
      "properties": {
        "ok": {
          "const": true
        }
      },
      "required": [
        "ok"
      ]
    },
    "AccountSnapshot": {
      "type": "object",
      "properties": {
        "balances": {
          "type": "array",
          "items": {
            "$ref": "urn:gitrader:schema:model:0.1:Balance"
          }
        },
        "margin": {
          "$ref": "urn:gitrader:schema:model:0.1:MarginSnapshot"
        },
        "positions": {
          "type": "array",
          "items": {
            "$ref": "urn:gitrader:schema:model:0.1:Position"
          }
        },
        "openOrders": {
          "type": "array",
          "items": {
            "$ref": "urn:gitrader:schema:model:0.1:Order"
          }
        },
        "ts": {
          "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/Ms"
        },
        "attestation": {
          "enum": [
            "engine-reported",
            "kernel-observed"
          ]
        }
      },
      "required": [
        "balances",
        "margin",
        "positions",
        "openOrders",
        "ts",
        "attestation"
      ]
    },
    "StrategyInstance": {
      "type": "object",
      "properties": {
        "instanceId": {
          "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/InstanceId"
        },
        "strategyId": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "running",
            "stopped",
            "error",
            "starting"
          ]
        },
        "accountId": {
          "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/AcctId"
        },
        "instruments": {
          "type": "array",
          "items": {
            "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/InstrumentId"
          }
        },
        "interval": {
          "type": "string"
        },
        "params": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "number",
              "boolean",
              "string"
            ]
          }
        },
        "mandateId": {
          "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/MdtId"
        },
        "startedAt": {
          "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/Ms"
        },
        "error": {
          "$ref": "urn:gitrader:schema:model:0.1:Problem"
        }
      },
      "required": [
        "instanceId",
        "strategyId",
        "status",
        "accountId",
        "instruments",
        "params",
        "mandateId"
      ]
    },
    "TakeoverScope": {
      "type": "object",
      "properties": {
        "accountIds": {
          "type": "array",
          "items": {
            "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/AcctId"
          }
        },
        "strategyIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "instrumentIds": {
          "type": "array",
          "items": {
            "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/InstrumentId"
          }
        }
      }
    },
    "EngineOrderParams": {
      "type": "object",
      "properties": {
        "accountId": {
          "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/AcctId"
        },
        "intent": {
          "$ref": "urn:gitrader:schema:model:0.1:OrderIntent"
        },
        "orderRef": {
          "type": "object",
          "properties": {
            "orderId": {
              "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/OrdId"
            },
            "clientOrderId": {
              "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/ClientOrderId"
            }
          },
          "anyOf": [
            {
              "required": [
                "orderId"
              ]
            },
            {
              "required": [
                "clientOrderId"
              ]
            }
          ]
        },
        "clientOrderId": {
          "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/ClientOrderId"
        },
        "takeoverId": {
          "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/TkoId"
        },
        "origin": {
          "$ref": "urn:gitrader:schema:model:0.1:Origin"
        }
      },
      "required": [
        "accountId",
        "origin"
      ]
    },
    "MarketChannel": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "quote",
            "book",
            "trades",
            "candles",
            "context"
          ]
        },
        "instrumentId": {
          "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/InstrumentId"
        },
        "interval": {
          "type": "string"
        },
        "depth": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "type",
        "instrumentId"
      ]
    },
    "MarketSubscribeParams": {
      "type": "object",
      "properties": {
        "channels": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "quote",
                  "book",
                  "trades",
                  "candles",
                  "context"
                ]
              },
              "instrumentId": {
                "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/InstrumentId"
              },
              "interval": {
                "type": "string"
              },
              "depth": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "type",
              "instrumentId"
            ]
          },
          "minItems": 1
        },
        "maxHz": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "channels"
      ]
    },
    "MarketSnapshotParams": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "quote",
            "book",
            "trades",
            "candles",
            "context"
          ]
        },
        "instrumentId": {
          "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/InstrumentId"
        },
        "depth": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "type",
        "instrumentId"
      ]
    },
    "MarketSnapshotResult": {
      "anyOf": [
        {
          "$ref": "urn:gitrader:schema:model:0.1:Quote"
        },
        {
          "$ref": "urn:gitrader:schema:model:0.1:Book"
        },
        {
          "type": "object",
          "properties": {
            "candles": {
              "type": "array",
              "items": {
                "$ref": "urn:gitrader:schema:model:0.1:Candle"
              }
            }
          },
          "required": [
            "candles"
          ]
        },
        {
          "type": "object",
          "properties": {
            "trades": {
              "type": "array",
              "items": {
                "$ref": "urn:gitrader:schema:model:0.1:Trade"
              }
            }
          },
          "required": [
            "trades"
          ]
        },
        {
          "$ref": "urn:gitrader:schema:model:0.1:MarketContext"
        }
      ]
    },
    "MarketHistoryParams": {
      "type": "object",
      "properties": {
        "instrumentId": {
          "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/InstrumentId"
        },
        "interval": {
          "type": "string",
          "minLength": 1
        },
        "from": {
          "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/Ms"
        },
        "to": {
          "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/Ms"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5000
        }
      },
      "required": [
        "instrumentId",
        "interval"
      ]
    },
    "MarketHistoryResult": {
      "type": "object",
      "properties": {
        "candles": {
          "type": "array",
          "items": {
            "$ref": "urn:gitrader:schema:model:0.1:Candle"
          }
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "complete": {
          "type": "boolean"
        }
      },
      "required": [
        "candles",
        "source",
        "complete"
      ]
    },
    "HostOrderPlaceParams": {
      "type": "object",
      "properties": {
        "accountId": {
          "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/AcctId"
        },
        "intent": {
          "$ref": "urn:gitrader:schema:model:0.1:OrderIntent"
        },
        "clientOrderId": {
          "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/ClientOrderId"
        },
        "strategyId": {
          "type": "string"
        },
        "instanceId": {
          "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/InstanceId"
        },
        "origin": {
          "$ref": "#/$defs/OriginHint"
        }
      },
      "required": [
        "accountId",
        "intent",
        "clientOrderId"
      ]
    },
    "HostOrderRef": {
      "type": "object",
      "properties": {
        "orderId": {
          "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/OrdId"
        },
        "clientOrderId": {
          "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/ClientOrderId"
        }
      },
      "anyOf": [
        {
          "required": [
            "orderId"
          ]
        },
        {
          "required": [
            "clientOrderId"
          ]
        }
      ]
    },
    "StrategySizing": {
      "type": "object",
      "properties": {
        "allocRatio": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "allocCapNotional": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "leverage": {
          "type": "number",
          "minimum": 1,
          "maximum": 50
        },
        "maxSlippageBps": {
          "type": "number",
          "minimum": 0
        },
        "minStepNotional": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "OriginHint": {
      "type": "object",
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "causation": {
          "type": "object",
          "properties": {}
        }
      },
      "required": [
        "tool"
      ]
    },
    "MarketCandleData": {
      "type": "object",
      "properties": {
        "interval": {
          "type": "string",
          "minLength": 1
        },
        "candle": {
          "$ref": "urn:gitrader:schema:model:0.1:Candle"
        },
        "closed": {
          "type": "boolean"
        }
      },
      "required": [
        "interval",
        "candle"
      ]
    },
    "MarketCandlesData": {
      "type": "object",
      "properties": {
        "interval": {
          "type": "string",
          "minLength": 1
        },
        "candles": {
          "type": "array",
          "items": {
            "$ref": "urn:gitrader:schema:model:0.1:Candle"
          }
        },
        "closed": {
          "type": "boolean"
        }
      },
      "required": [
        "interval",
        "candles"
      ]
    },
    "ReplayState": {
      "type": "object",
      "properties": {
        "replayId": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "running",
            "paused",
            "done",
            "stopped"
          ]
        },
        "clock": {
          "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/Ms"
        }
      },
      "required": [
        "replayId",
        "state",
        "clock"
      ]
    },
    "BacktestState": {
      "enum": [
        "queued",
        "running",
        "done",
        "failed",
        "cancelled"
      ]
    },
    "gep.hello:params": {
      "$ref": "urn:gitrader:schema:gep:0.1:GepHelloParams"
    },
    "gep.hello:result": {
      "$ref": "urn:gitrader:schema:gep:0.1:GepHelloResult"
    },
    "engine.describe:params": {
      "$ref": "#/$defs/Empty"
    },
    "engine.describe:result": {
      "$ref": "urn:gitrader:schema:gep:0.1:EngineDescribe"
    },
    "engine.bind:params": {
      "$ref": "urn:gitrader:schema:gep:0.1:Binding"
    },
    "engine.bind:result": {
      "$ref": "urn:gitrader:schema:gep:0.1:BindResult"
    },
    "engine.health:params": {
      "$ref": "#/$defs/Empty"
    },
    "engine.health:result": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "ok",
            "degraded",
            "down"
          ]
        },
        "metrics": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "ts": {
          "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/Ms"
        }
      },
      "required": [
        "status",
        "metrics",
        "ts"
      ]
    },
    "engine.snapshot:params": {
      "type": "object",
      "properties": {
        "accountIds": {
          "type": "array",
          "items": {
            "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/AcctId"
          }
        }
      }
    },
    "engine.snapshot:result": {
      "type": "object",
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "strategies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StrategyInstance"
          }
        },
        "orders": {
          "type": "array",
          "items": {
            "$ref": "urn:gitrader:schema:model:0.1:Order"
          }
        },
        "positions": {
          "type": "array",
          "items": {
            "$ref": "urn:gitrader:schema:model:0.1:Position"
          }
        },
        "accounts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AccountSnapshot"
          }
        }
      },
      "required": [
        "seq",
        "strategies",
        "orders"
      ]
    },
    "engine.halt:params": {
      "type": "object",
      "properties": {
        "takeoverId": {
          "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/TkoId"
        },
        "level": {
          "enum": [
            "halt_new",
            "cancel_all",
            "flatten_all"
          ]
        },
        "scope": {
          "type": "object",
          "properties": {
            "accountIds": {
              "type": "array",
              "items": {
                "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/AcctId"
              }
            },
            "strategyIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "instrumentIds": {
              "type": "array",
              "items": {
                "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/InstrumentId"
              }
            }
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "deadlineMs": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "takeoverId",
        "level",
        "scope",
        "reason",
        "deadlineMs"
      ]
    },
    "engine.halt:result": {
      "type": "object",
      "properties": {
        "ack": {
          "const": true
        },
        "appliedAt": {
          "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/Ms"
        }
      },
      "required": [
        "ack",
        "appliedAt"
      ]
    },
    "engine.resume:params": {
      "type": "object",
      "properties": {
        "takeoverId": {
          "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/TkoId"
        },
        "scope": {
          "type": "object",
          "properties": {
            "accountIds": {
              "type": "array",
              "items": {
                "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/AcctId"
              }
            },
            "strategyIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "instrumentIds": {
              "type": "array",
              "items": {
                "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/InstrumentId"
              }
            }
          }
        },
        "approvedBy": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "takeoverId",
        "scope",
        "approvedBy"
      ]
    },
    "engine.resume:result": {
      "type": "object",
      "properties": {
        "resumedAt": {
          "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/Ms"
        }
      },
      "required": [
        "resumedAt"
      ]
    },
    "engine.shutdown:params": {
      "type": "object",
      "properties": {
        "graceMs": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "graceMs"
      ]
    },
    "engine.shutdown:result": {
      "type": "object",
      "properties": {
        "ok": {
          "const": true
        }
      },
      "required": [
        "ok"
      ]
    },
    "events.subscribe:params": {
      "type": "object",
      "properties": {
        "streams": {
          "type": "array",
          "items": {
            "enum": [
              "order",
              "fill",
              "position",
              "funding",
              "account",
              "strategy",
              "signal",
              "decision",
              "backtest",
              "takeover",
              "policy",
              "health",
              "log",
              "market"
            ]
          },
          "minItems": 1
        },
        "accountIds": {
          "type": "array",
          "items": {
            "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/AcctId"
          }
        },
        "fromSeq": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "streams"
      ]
    },
    "events.subscribe:result": {
      "type": "object",
      "properties": {
        "subscriptionId": {
          "type": "string",
          "minLength": 1
        },
        "fromSeq": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "subscriptionId",
        "fromSeq"
      ]
    },
    "events.unsubscribe:params": {
      "type": "object",
      "properties": {
        "subscriptionId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "subscriptionId"
      ]
    },
    "events.unsubscribe:result": {
      "type": "object",
      "properties": {
        "ok": {
          "const": true
        }
      },
      "required": [
        "ok"
      ]
    },
    "risk.policy.push:params": {
      "type": "object",
      "properties": {
        "policies": {
          "type": "array",
          "items": {
            "$ref": "urn:gitrader:schema:model:0.1:RiskPolicy"
          },
          "minItems": 1
        },
        "effectiveAt": {
          "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/Ms"
        }
      },
      "required": [
        "policies",
        "effectiveAt"
      ]
    },
    "risk.policy.push:result": {
      "type": "object",
      "properties": {
        "acceptedVersions": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "required": [
        "acceptedVersions"
      ]
    },
    "strategy.list:params": {
      "$ref": "#/$defs/Empty"
    },
    "strategy.list:result": {
      "type": "object",
      "properties": {
        "strategies": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "paramsSchemaRef": {
                "type": "string"
              },
              "sha256": {
                "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/Sha256"
              }
            },
            "required": [
              "id",
              "name",
              "version",
              "kind"
            ]
          }
        }
      },
      "required": [
        "strategies"
      ]
    },
    "strategy.params:params": {
      "type": "object",
      "properties": {
        "strategyId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "strategyId"
      ]
    },
    "strategy.params:result": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "object"
        },
        "defaults": {
          "type": "object"
        }
      },
      "required": [
        "schema",
        "defaults"
      ]
    },
    "strategy.start:params": {
      "type": "object",
      "properties": {
        "strategyId": {
          "type": "string",
          "minLength": 1
        },
        "instanceId": {
          "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/InstanceId"
        },
        "accountId": {
          "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/AcctId"
        },
        "instruments": {
          "type": "array",
          "items": {
            "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/InstrumentId"
          },
          "minItems": 1
        },
        "interval": {
          "type": "string"
        },
        "params": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "number",
              "boolean",
              "string"
            ]
