{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gitrader:schema:gep:0.1:JsonRpcRequest",
  "$comment": "SPDX-License-Identifier: Apache-2.0 | Spec: gep | Version: 0.1 | Status: draft",
  "title": "JsonRpcRequest",
  "type": "object",
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "id": {
      "type": [
        "string",
        "integer"
      ]
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "params": {
      "type": [
        "object",
        "array"
      ]
    }
  },
  "required": [
    "jsonrpc",
    "id",
    "method"
  ]
}
