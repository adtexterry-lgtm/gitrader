{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gitrader:schema:model:0.1:Signal",
  "$comment": "SPDX-License-Identifier: Apache-2.0 | Spec: model | Version: 0.1 | Status: draft",
  "title": "Signal",
  "type": "object",
  "properties": {
    "signalId": {
      "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/SigId"
    },
    "ts": {
      "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/Ms"
    },
    "instrumentId": {
      "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/InstrumentId"
    },
    "kind": {
      "enum": [
        "target",
        "entry",
        "exit",
        "alert"
      ]
    },
    "target": {
      "type": "number",
      "minimum": -1,
      "maximum": 1
    },
    "strength": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "method": {
      "type": "string"
    },
    "expiresAt": {
      "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/Ms"
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "enum": [
              "signal",
              "decision",
              "note",
              "backtest",
              "experiment"
            ]
          },
          "id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "type",
          "id"
        ]
      }
    },
    "origin": {
      "$ref": "urn:gitrader:schema:model:0.1:Origin"
    }
  },
  "required": [
    "signalId",
    "ts",
    "instrumentId",
    "kind",
    "expiresAt",
    "reason",
    "origin"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "target"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "target"
        ]
      }
    },
    {
      "if": {
        "anyOf": [
          {
            "required": [
              "strength"
            ]
          },
          {
            "required": [
              "confidence"
            ]
          }
        ]
      },
      "then": {
        "required": [
          "method"
        ]
      }
    }
  ]
}
