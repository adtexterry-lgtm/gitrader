{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gitrader:schema:plugin:1",
  "$comment": "SPDX-License-Identifier: Apache-2.0 | Spec: plugin | Version: 1 | Status: draft",
  "title": "PluginManifest",
  "type": "object",
  "properties": {
    "schema": {
      "const": "gitrader-plugin/1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+){2,}$"
    },
    "package": {
      "enum": [
        "skill",
        "block"
      ]
    },
    "kind": {
      "enum": [
        "connector",
        "datasource",
        "factor",
        "decision-model",
        "executor",
        "protector",
        "strategy",
        "workflow-template",
        "engine",
        "block",
        "skill",
        "layout-preset"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "desc": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
    },
    "vendor": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "builtin",
            "partner",
            "community",
            "self"
          ]
        },
        "verified": {
          "type": "boolean"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "name",
        "kind",
        "verified"
      ]
    },
    "source": {
      "type": "object",
      "properties": {
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "sha256": {
          "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/Sha256"
        },
        "fetchedAt": {
          "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/Ms"
        },
        "inspiredBy": {
          "type": "string"
        }
      },
      "required": [
        "repo",
        "commit",
        "sha256",
        "fetchedAt"
      ]
    },
    "license": {
      "type": "object",
      "properties": {
        "spdx": {
          "type": "string",
          "minLength": 1
        },
        "redistribute": {
          "enum": [
            "bundle",
            "implement",
            "user-install",
            "reference-only"
          ]
        },
        "notice": {
          "type": "string"
        },
        "commercialUse": {
          "type": "boolean"
        },
        "attribution": {
          "type": "string"
        },
        "weightsLicense": {
          "type": "string"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "spdx": {
                "type": "string",
                "minLength": 1
              },
              "redistribute": {
                "enum": [
                  "bundle",
                  "implement",
                  "user-install",
                  "reference-only"
                ]
              }
            },
            "required": [
              "name",
              "spdx",
              "redistribute"
            ]
          }
        }
      },
      "required": [
        "spdx",
        "redistribute",
        "notice",
        "commercialUse"
      ]
    },
    "runtime": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "builtin",
            "node",
            "sidecar",
            "python-sidecar",
            "browser",
            "stdio-mcp",
            "remote-mcp",
            "rest"
          ]
        },
        "node": {
          "type": "string"
        },
        "python": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+$"
        },
        "native": {
          "type": "boolean"
        },
        "diskMB": {
          "type": "number",
          "minimum": 0
        },
        "download": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "sizeMB": {
                "type": "number",
                "minimum": 0
              },
              "sha256": {
                "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/Sha256"
              },
              "consent": {
                "const": "required"
              }
            },
            "required": [
              "name",
              "source",
              "sizeMB",
              "sha256",
              "consent"
            ]
          }
        }
      },
      "required": [
        "type",
        "native",
        "diskMB"
      ]
    },
    "entry": {
      "type": "object",
      "properties": {
        "module": {
          "type": "string"
        },
        "export": {
          "type": "string"
        },
        "element": {
          "type": "string"
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "transport": {
          "enum": [
            "stdio",
            "ws",
            "wss"
          ]
        },
        "url": {
          "type": "string"
        }
      }
    },
    "install": {
      "type": "object",
      "properties": {
        "by": {
          "enum": [
            "bundle",
            "user-consent",
            "user-install",
            "remote"
          ]
        },
        "detect": {
          "type": "string"
        },
        "lockfile": {
          "type": "string"
        },
        "requireHashes": {
          "const": true
        }
      },
      "required": [
        "by",
        "requireHashes"
      ]
    },
    "permissions": {
      "type": "array",
      "items": {
        "enum": [
          "market.read",
          "account.read",
          "ledger.read",
          "ledger.append",
          "trade.paper",
          "trade.propose",
          "trade.live",
          "takeover.trigger",
          "venue.credentials",
          "net.fetch",
          "fs.read.user",
          "workspace.control",
          "ui.block",
          "notify.user"
        ]
      },
      "uniqueItems": true
    },
    "net": {
      "type": "object",
      "properties": {
        "hosts": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(\\*\\.)?[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
          }
        }
      },
      "required": [
        "hosts"
      ]
    },
    "secrets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "config": {
      "type": "object"
    },
    "privacy": {
      "type": "object",
      "properties": {
        "hosted": {
          "type": "boolean"
        },
        "sends": {
          "type": "array",
          "items": {
            "enum": [
              "watchlist",
              "positions",
              "addresses",
              "orders"
            ]
          }
        }
      },
      "required": [
        "hosted",
        "sends"
      ]
    },
    "tos": {
      "type": "object",
      "properties": {
        "commercial": {
          "type": "boolean"
        },
        "redistribute": {
          "type": "boolean"
        },
        "attribution": {
          "type": "string"
        }
      },
      "required": [
        "commercial",
        "redistribute",
        "attribution"
      ]
    },
    "mcp": {
      "type": "object",
      "properties": {
        "transport": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string"
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tools": {
          "type": "object",
          "properties": {
            "allow": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "deny": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "allow",
            "deny"
          ]
        }
      },
      "required": [
        "transport",
        "tools"
      ]
    },
    "provides": {
      "type": "object"
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "desc": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "input": {
            "type": "object"
          },
          "output": {
            "type": "object"
          },
          "permissions": {
            "type": "array",
            "items": {
              "enum": [
                "market.read",
                "account.read",
                "ledger.read",
                "ledger.append",
                "trade.paper",
                "trade.propose",
                "trade.live",
                "takeover.trigger",
                "venue.credentials",
                "net.fetch",
                "fs.read.user",
                "workspace.control",
                "ui.block",
                "notify.user"
              ]
            }
          }
        },
        "required": [
          "name",
          "desc",
          "tags",
          "input"
        ]
      }
    },
    "instances": {
      "type": "object",
      "properties": {
        "multiple": {
          "type": "boolean"
        },
        "ordered": {
          "type": "boolean"
        },
        "max": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "multiple",
        "ordered"
      ]
    },
    "ui": {
      "type": "object",
      "properties": {
        "blocks": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object"
              },
              {
                "type": "string"
              }
            ]
          }
        }
      },
      "required": [
        "blocks"
      ]
    },
    "engine": {
      "type": "object",
      "properties": {
        "gep": {
          "type": "object",
          "properties": {
            "versions": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            "transports": {
              "type": "array",
              "items": {
                "enum": [
                  "stdio",
                  "ws",
                  "wss"
                ]
              },
              "minItems": 1
            },
            "modes": {
              "type": "array",
              "items": {
                "enum": [
                  "A",
                  "B"
                ]
              },
              "minItems": 1
            }
          },
          "required": [
            "versions",
            "transports",
            "modes"
          ]
        },
        "launch": {
          "$ref": "urn:gitrader:schema:gep:0.1:EngineLaunch"
        }
      },
      "required": [
        "gep"
      ]
    },
    "evidence": {
      "type": "object",
      "properties": {
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "metric": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/Decimal"
              },
              "basis": {
                "enum": [
                  "backtest",
                  "paper",
                  "live"
                ]
              },
              "window": {
                "type": "object",
                "properties": {
                  "from": {
                    "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/Ms"
                  },
                  "to": {
                    "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/Ms"
                  }
                },
                "required": [
                  "from",
                  "to"
                ]
              },
              "ref": {
                "type": "string"
              },
              "assumptions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "metric",
              "value",
              "basis",
              "window"
            ]
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "claims"
      ]
    },
    "protector": {
      "type": "object",
      "properties": {
        "rules": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "urn:gitrader:schema:model:0.1:Protector"
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "not": {
                      "enum": [
                        "cooldown",
                        "stoploss_guard",
                        "drawdown_pause",
                        "low_profit_lock",
                        "max_consecutive_failures"
                      ]
                    }
                  }
                },
                "required": [
                  "kind"
                ]
              }
            ]
          }
        },
        "pre": {
          "type": "boolean"
        },
        "budgetMs": {
          "type": "number"
        }
      }
    },
    "fixtures": {
      "type": "object",
      "properties": {
        "offline": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "smoke": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "offline",
        "smoke"
      ]
    },
    "risk": {
      "type": "object",
      "properties": {
        "disclosure": {
          "type": "string",
          "minLength": 1
        },
        "worstCase": {
          "type": "string",
          "minLength": 1
        },
        "builderAttribution": {
          "const": "off"
        }
      },
      "required": [
        "disclosure",
        "worstCase",
        "builderAttribution"
      ]
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "plugin",
              "pypi",
              "npm",
              "binary"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
          },
          "sha256": {
            "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/Sha256"
          }
        },
        "required": [
          "kind",
          "name",
          "version",
          "sha256"
        ]
      }
    },
    "compat": {
      "type": "object",
      "properties": {
        "gitrader": {
          "type": "string",
          "minLength": 1
        },
        "gep": {
          "type": "string"
        },
        "pluginSchema": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "gitrader",
        "pluginSchema"
      ]
    },
    "signature": {
      "type": "object",
      "properties": {
        "alg": {
          "const": "ed25519"
        },
        "keyId": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/Sha256"
        },
        "sig": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "alg",
        "keyId",
        "digest",
        "sig"
      ]
    }
  },
  "required": [
    "schema",
    "id",
    "package",
    "kind",
    "name",
    "desc",
    "tags",
    "version",
    "vendor",
    "source",
    "license",
    "runtime",
    "install",
    "permissions",
    "privacy",
    "provides",
    "fixtures",
    "compat"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "engine"
            ]
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "engine"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "datasource"
            ]
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "tos"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "strategy",
              "factor",
              "decision-model"
            ]
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "evidence"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "strategy",
              "executor"
            ]
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "risk"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "permissions": {
            "contains": {
              "const": "net.fetch"
            }
          }
        },
        "required": [
          "permissions"
        ]
      },
      "then": {
        "required": [
          "net"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "runtime": {
            "properties": {
              "type": {
                "enum": [
                  "stdio-mcp",
                  "remote-mcp"
                ]
              }
            },
            "required": [
              "type"
            ]
          }
        },
        "required": [
          "runtime"
        ]
      },
      "then": {
        "required": [
          "mcp"
        ]
      }
    }
  ]
}
