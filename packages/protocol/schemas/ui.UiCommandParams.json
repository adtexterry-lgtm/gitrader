{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gitrader:schema:ui:0.1:UiCommandParams",
  "$comment": "SPDX-License-Identifier: Apache-2.0 | Spec: ui | Version: 0.1 | Status: draft",
  "title": "UiCommandParams",
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
