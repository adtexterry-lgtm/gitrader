{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gitrader:schema:model:0.1:ModelTrainedPayload",
  "$comment": "SPDX-License-Identifier: Apache-2.0 | Spec: model | Version: 0.1 | Status: draft",
  "title": "ModelTrainedPayload",
  "type": "object",
  "properties": {
    "modelId": {
      "type": "string",
      "minLength": 1
    },
    "modelVersion": {
      "type": "string",
      "minLength": 1
    },
    "modelSha256": {
      "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/Sha256"
    },
    "trainWindow": {
      "type": "object",
      "properties": {
        "from": {
          "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/Ms"
        },
        "to": {
          "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/Ms"
        }
      },
      "required": [
        "from",
        "to"
      ]
    },
    "labelMaturityMs": {
      "type": "integer",
      "minimum": 0
    },
    "sampleCount": {
      "type": "integer",
      "minimum": 0
    },
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    }
  },
  "required": [
    "modelId",
    "modelVersion",
    "modelSha256",
    "trainWindow",
    "labelMaturityMs",
    "sampleCount"
  ]
}
