{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gitrader:schema:model:0.1:DecisionRecord",
  "$comment": "SPDX-License-Identifier: Apache-2.0 | Spec: model | Version: 0.1 | Status: draft",
  "title": "DecisionRecord",
  "type": "object",
  "properties": {
    "decisionId": {
      "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/DecId"
    },
    "ts": {
      "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/Ms"
    },
    "plugin": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/Sha256"
        }
      },
      "required": [
        "id",
        "version",
        "sha256"
      ]
    },
    "endpoint": {
      "type": "object",
      "properties": {
        "configId": {
          "type": "string",
          "minLength": 1
        },
        "host": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "configId",
        "host"
      ]
    },
    "primitive": {
      "type": "string",
      "minLength": 1
    },
    "input": {
      "type": "object",
      "properties": {
        "digest": {
          "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/Sha256"
        },
        "refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "digest",
        "refs"
      ]
    },
    "output": {
      "type": "object",
      "properties": {
        "choice": {
          "type": "string"
        },
        "probabilities": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "score": {
          "type": "number"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "modelVersion": {
      "type": "string",
      "minLength": 1
    },
    "latencyMs": {
      "type": "number",
      "minimum": 0
    },
    "latencyBudgetMs": {
      "type": "number",
      "minimum": 0
    },
    "withinBudget": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "ok",
        "timeout",
        "error"
      ]
    },
    "cost": {
      "type": "object",
      "properties": {
        "amount": {
          "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/Decimal"
        },
        "ccy": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "amount",
        "ccy"
      ]
    },
    "outcome": {
      "type": "object",
      "properties": {
        "resolvedAt": {
          "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/Ms"
        },
        "label": {
          "type": "string"
        },
        "realizedReturnRatio": {
          "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/Decimal"
        },
        "used": {
          "type": "boolean"
        }
      },
      "required": [
        "resolvedAt",
        "used"
      ]
    },
    "origin": {
      "$ref": "urn:gitrader:schema:model:0.1:Origin"
    }
  },
  "required": [
    "decisionId",
    "ts",
    "plugin",
    "endpoint",
    "primitive",
    "input",
    "output",
    "latencyMs",
    "latencyBudgetMs",
    "withinBudget",
    "status",
    "origin"
  ]
}
