{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gitrader:schema:model:0.1:EvidencePackRef",
  "$comment": "SPDX-License-Identifier: Apache-2.0 | Spec: model | Version: 0.1 | Status: draft",
  "title": "EvidencePackRef",
  "type": "object",
  "properties": {
    "packId": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "backtest",
        "holdout",
        "forward"
      ]
    },
    "tier": {
      "enum": [
        "hypothetical",
        "forward_paper",
        "forward_live"
      ]
    },
    "digest": {
      "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/Sha256"
    },
    "at": {
      "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/Ms"
    },
    "runId": {
      "type": "string"
    }
  },
  "required": [
    "packId",
    "kind",
    "tier",
    "digest",
    "at"
  ]
}
