{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gitrader:schema:model:0.1:PaperReplayFixture",
  "$comment": "SPDX-License-Identifier: Apache-2.0 | Spec: model | Version: 0.1 | Status: draft",
  "title": "PaperReplayFixture",
  "type": "object",
  "properties": {
    "schema": {
      "const": "gitrader-paper-replay/1"
    },
    "venue": {
      "$ref": "urn:gitrader:schema:model:0.1:Common#/$defs/VenueId"
    },
    "instruments": {
      "type": "array",
      "items": {
        "$ref": "urn:gitrader:schema:model:0.1:Instrument"
      },
      "minItems": 1,
      "maxItems": 100
    },
    "interval": {
      "enum": [
        "1m",
        "3m",
        "5m",
        "15m",
        "30m",
        "1h",
        "2h",
        "4h",
        "8h",
        "12h",
        "1d",
        "3d",
        "1w",
        "1M"
      ]
    },
    "frames": {
      "type": "array",
      "items": {
        "$ref": "urn:gitrader:schema:model:0.1:PaperReplayFrame"
      },
      "minItems": 1,
      "maxItems": 100000
    }
  },
  "required": [
    "schema",
    "venue",
    "instruments",
    "interval",
    "frames"
  ]
}
