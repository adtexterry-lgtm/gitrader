{
  "schema": "gitrader-workflow/2",
  "id": "tpl.breakout",
  "name": "突破·唐奇安通道（教学示例）",
  "desc": "收盘价突破前 N 根最高价做多、跌破前 N 根最低价做空，反向跌破较短通道离场。",
  "version": 1,
  "params": {
    "entry": 20,
    "exit": 10,
    "allowShort": true
  },
  "paramDefs": [
    {
      "key": "entry",
      "label": "入场通道（根）",
      "type": "integer",
      "default": 20,
      "min": 5,
      "max": 200
    },
    {
      "key": "exit",
      "label": "离场通道（根）",
      "type": "integer",
      "default": 10,
      "min": 2,
      "max": 100
    },
    {
      "key": "allowShort",
      "label": "允许做空",
      "type": "boolean",
      "default": true
    }
  ],
  "nodes": [
    {
      "id": "k",
      "type": "data.candles",
      "params": {},
      "position": {
        "x": 20,
        "y": 160
      },
      "label": "K 线"
    },
    {
      "id": "ch_in",
      "type": "ind.donchian",
      "params": {
        "period": "$entry"
      },
      "position": {
        "x": 240,
        "y": 80
      },
      "label": "入场通道"
    },
    {
      "id": "ch_out",
      "type": "ind.donchian",
      "params": {
        "period": "$exit"
      },
      "position": {
        "x": 240,
        "y": 240
      },
      "label": "离场通道"
    },
    {
      "id": "c_gt_hi",
      "type": "cond.compare",
      "params": {
        "op": ">"
      },
      "position": {
        "x": 460,
        "y": 40
      },
      "label": "收 > 入场上轨"
    },
    {
      "id": "c_lt_lo",
      "type": "cond.compare",
      "params": {
        "op": "<"
      },
      "position": {
        "x": 460,
        "y": 140
      },
      "label": "收 < 入场下轨"
    },
    {
      "id": "c_lt_xlo",
      "type": "cond.compare",
      "params": {
        "op": "<"
      },
      "position": {
        "x": 460,
        "y": 240
      },
      "label": "收 < 离场下轨"
    },
    {
      "id": "c_gt_xhi",
      "type": "cond.compare",
      "params": {
        "op": ">"
      },
      "position": {
        "x": 460,
        "y": 340
      },
      "label": "收 > 离场上轨"
    },
    {
      "id": "sig",
      "type": "sig.state",
      "params": {
        "mode": "latch",
        "allowShort": "$allowShort"
      },
      "position": {
        "x": 700,
        "y": 190
      },
      "label": "突破"
    },
    {
      "id": "out_signal",
      "type": "act.signal",
      "params": {},
      "position": {
        "x": 760,
        "y": 260
      },
      "label": "输出信号"
    },
    {
      "id": "size",
      "type": "risk.size",
      "params": {
        "allocRatio": 0.1,
        "allocCapNotional": 500,
        "leverage": 1
      },
      "position": {
        "x": 760,
        "y": 380
      },
      "label": "仓位计算"
    },
    {
      "id": "precheck",
      "type": "risk.precheck",
      "params": {},
      "position": {
        "x": 960,
        "y": 380
      },
      "label": "风控预检"
    },
    {
      "id": "place",
      "type": "act.order",
      "params": {},
      "position": {
        "x": 1160,
        "y": 380
      },
      "label": "下单"
    }
  ],
  "edges": [
    {
      "from": {
        "node": "k",
        "port": "high"
      },
      "to": {
        "node": "ch_in",
        "port": "high"
      }
    },
    {
      "from": {
        "node": "k",
        "port": "low"
      },
      "to": {
        "node": "ch_in",
        "port": "low"
      }
    },
    {
      "from": {
        "node": "k",
        "port": "high"
      },
      "to": {
        "node": "ch_out",
        "port": "high"
      }
    },
    {
      "from": {
        "node": "k",
        "port": "low"
      },
      "to": {
        "node": "ch_out",
        "port": "low"
      }
    },
    {
      "from": {
        "node": "k",
        "port": "close"
      },
      "to": {
        "node": "c_gt_hi",
        "port": "a"
      }
    },
    {
      "from": {
        "node": "ch_in",
        "port": "upper"
      },
      "to": {
        "node": "c_gt_hi",
        "port": "b"
      }
    },
    {
      "from": {
        "node": "k",
        "port": "close"
      },
      "to": {
        "node": "c_lt_lo",
        "port": "a"
      }
    },
    {
      "from": {
        "node": "ch_in",
        "port": "lower"
      },
      "to": {
        "node": "c_lt_lo",
        "port": "b"
      }
    },
    {
      "from": {
        "node": "k",
        "port": "close"
      },
      "to": {
        "node": "c_lt_xlo",
        "port": "a"
      }
    },
    {
      "from": {
        "node": "ch_out",
        "port": "lower"
      },
      "to": {
        "node": "c_lt_xlo",
        "port": "b"
      }
    },
    {
      "from": {
        "node": "k",
        "port": "close"
      },
      "to": {
        "node": "c_gt_xhi",
        "port": "a"
      }
    },
    {
      "from": {
        "node": "ch_out",
        "port": "upper"
      },
      "to": {
        "node": "c_gt_xhi",
        "port": "b"
      }
    },
    {
      "from": {
        "node": "c_gt_hi",
        "port": "out"
      },
      "to": {
        "node": "sig",
        "port": "enterLong"
      }
    },
    {
      "from": {
        "node": "c_lt_lo",
        "port": "out"
      },
      "to": {
        "node": "sig",
        "port": "enterShort"
      }
    },
    {
      "from": {
        "node": "c_lt_xlo",
        "port": "out"
      },
      "to": {
        "node": "sig",
        "port": "exitLong"
      }
    },
    {
      "from": {
        "node": "c_gt_xhi",
        "port": "out"
      },
      "to": {
        "node": "sig",
        "port": "exitShort"
      }
    },
    {
      "from": {
        "node": "sig",
        "port": "signal"
      },
      "to": {
        "node": "out_signal",
        "port": "signal"
      }
    },
    {
      "from": {
        "node": "sig",
        "port": "signal"
      },
      "to": {
        "node": "size",
        "port": "signal"
      }
    },
    {
      "from": {
        "node": "size",
        "port": "order"
      },
      "to": {
        "node": "precheck",
        "port": "order"
      }
    },
    {
      "from": {
        "node": "precheck",
        "port": "order"
      },
      "to": {
        "node": "place",
        "port": "order"
      }
    }
  ],
  "meta": {
    "source": {
      "author": "Gitrader",
      "license": "CPAL-1.0"
    },
    "builtin": true,
    "strategyId": "breakout",
    "tags": [
      "趋势",
      "突破",
      "海龟"
    ]
  }
}
