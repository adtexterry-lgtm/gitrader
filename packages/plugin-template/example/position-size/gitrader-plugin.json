        "required": [
          "equity",
          "riskPct",
          "entry",
          "stop"
        ],
        "properties": {
          "equity": {
            "type": "string",
            "pattern": "^[0-9]+(\\.[0-9]+)?$"
          },
          "riskPct": {
            "type": "string",
            "pattern": "^[0-9]+(\\.[0-9]+)?$"
          },
          "entry": {
            "type": "string",
            "pattern": "^[0-9]+(\\.[0-9]+)?$"
          },
          "stop": {
            "type": "string",
            "pattern": "^[0-9]+(\\.[0-9]+)?$"
          }
        },
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "required": [
          "qty"
        ],
        "properties": {
          "qty": {
            "type": "string"
          }
        }
      },
      "permissions": []
    }
  ],
